APP_ENV=production
APP_NAME=集团账号管理中台 API
APP_HOST=127.0.0.1
APP_PORT=8100
APP_DEBUG=false
DATABASE_URL=postgresql+psycopg://account_center:CHANGE_ME@127.0.0.1:5432/account_center
CORS_ORIGINS=["http://jtzhzt.flipbeltchina.com","https://jtzhzt.flipbeltchina.com"]
SESSION_COOKIE_NAME=account_center_session
SESSION_TTL_HOURS=12
SESSION_SECURE_COOKIE=true
DINGTALK_ENABLED=false
# 在受管环境中单独配置，绝不提交 ClientSecret。
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=
# 可选：资料接入语义分析。密钥仅写入受管环境变量，绝不提交。
AI_IMPORT_ENABLED=false
AI_IMPORT_BASE_URL=
AI_IMPORT_API_KEY=
AI_IMPORT_MODEL=
AI_IMPORT_TIMEOUT_SECONDS=30
AI_IMPORT_MAX_ROWS_PER_REQUEST=50
AI_IMPORT_MAX_RETRIES=1
# Dedicated control-plane allowlist. This is a login name, not a password.
DEVELOPER_SUPERVISOR_USERNAME=
