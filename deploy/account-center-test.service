[Unit]
Description=Group Account Center API (isolated test environment)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=accountcenter
Group=accountcenter
WorkingDirectory=/opt/account-center-test/backend
EnvironmentFile=/etc/account-center-test/app.env
ExecStart=/opt/account-center-test/.venv/bin/python -m uvicorn app.main:app --app-dir /opt/account-center-test/backend --host 127.0.0.1 --port 8200
Restart=always
RestartSec=3
TimeoutStopSec=20
MemoryHigh=350M
MemoryMax=500M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
