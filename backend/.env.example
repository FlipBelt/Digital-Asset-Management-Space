APP_ENV=local
APP_NAME=集团账号管理中台 API
APP_HOST=127.0.0.1
APP_PORT=8100
APP_DEBUG=true
DATABASE_URL=postgresql+psycopg://account_center:change-me@127.0.0.1:55432/account_center
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
DEVELOPER_SUPERVISOR_USERNAME=

# Keep production and /test/ session cookie names distinct.
SESSION_COOKIE_NAME=account_center_session
SESSION_SECURE_COOKIE=false
DINGTALK_ENABLED=false
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=
DINGTALK_WEB_ENABLED=false
DINGTALK_WEB_REDIRECT_URI=
DINGTALK_WEB_FRONTEND_URL=

# Delegated AI incubator / registrar connector: enable only after migration and review.
AGENT_CONNECTOR_ENABLED=false
AGENT_FRONTEND_URL=https://jtzhzt.flipbeltchina.com
AGENT_TOKEN_TTL_HOURS=24
